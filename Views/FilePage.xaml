<Page x:Class="FluentGit.Views.FilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:FluentGit.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">
    <Grid Margin="30,90,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="FileTitle"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15" />

        <TextBlock x:Name="NoRepoText"
                   Grid.Row="1"
                   x:Uid="CommonNoRepo"
                   Foreground="Gray" />

        <TreeView x:Name="DirectoryTreeView"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  ItemInvoked="DirectoryTreeView_ItemInvoked"
                  RightTapped="DirectoryTreeView_RightTapped"
                  Expanding="DirectoryTreeView_Expanding">
            <TreeView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="20">
                        <Image Width="12" Height="12"
                               Source="{Binding Content.IconSource}"
                               Stretch="Uniform" />
                        <TextBlock Text="{Binding Content.Name}"
                                   VerticalAlignment="Center"
                                   FontSize="13" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Page>