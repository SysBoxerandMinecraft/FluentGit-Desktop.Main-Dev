<Page x:Class="FluentGit.Views.RepoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:FluentGit.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">
    <Page.Resources>
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y"
                             From="-80" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-80" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>
    <Grid>
        <!-- InfoBar 容器 -->
        <Border x:Name="InfoBarContainer"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="20,20,20,0"
                MinWidth="400"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InfoBarTransform" Y="-80" />
            </Border.RenderTransform>
            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Success"
                     Title=""
                     Message=""
                     MaxWidth="500" />
        </Border>

        <!-- 主内容 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="30,90,30,30" MinWidth="400">

                <TextBlock x:Name="RepoNameDisplay" FontSize="24" FontWeight="SemiBold"
                           Visibility="Collapsed" Margin="0,0,0,15" />

                <StackPanel x:Name="GitWarningPanel" Visibility="Collapsed" Spacing="10" Margin="0,0,0,15">
                    <TextBlock x:Uid="RepoGitNotFound" FontSize="16" Foreground="Red" />
                    <HyperlinkButton Content="Download Git for Windows" NavigateUri="https://git-scm.com/install/windows" />
                </StackPanel>

                <!-- 操作面板：初始化 / 打开 / 克隆 -->
                <StackPanel x:Name="RepoActionsPanel" Visibility="Visible" Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RepoPathTextBox" Grid.Column="0"
                                 x:Uid="RepoPath"
                                 MinHeight="32" Margin="0,0,10,0" />
                        <Button Grid.Column="1" x:Uid="RepoBrowse" Click="OnBrowseForInit" MinHeight="32" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="InitRepoButton" x:Uid="RepoInit"
                                Click="OnInitRepository" MinHeight="32" />
                        <Button x:Name="OpenRepoButton" x:Uid="RepoOpen"
                                Click="OnOpenRepo" MinHeight="32" />
                        <Button x:Name="CloneRepoButton" x:Uid="RepoClone"
                                Click="OnNavigateToClone" MinHeight="32" />
                    </StackPanel>
                </StackPanel>

                <!-- 仓库操作面板（打开仓库后显示） -->
                <Border x:Name="RepoOpsPanel"
                        BorderBrush="Gray" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0" Margin="0,15,0,0"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="RepoOpsTitle" FontWeight="SemiBold" FontSize="16" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="PullButton" x:Uid="RepoPull"
                                    Click="OnPullRepository" MinHeight="32" />
                            <Button x:Name="FetchButton" x:Uid="RepoFetch"
                                    Click="OnFetchRepository" MinHeight="32" />
                            <Button x:Name="PushButton" x:Uid="RepoPush"
                                    Click="OnPushRepository" MinHeight="32" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 提交面板（打开仓库后显示） -->
                <Border x:Name="CommitPanel"
                        BorderBrush="Gray" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0" Margin="0,15,0,0"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="RepoCommitTitle" FontWeight="SemiBold" FontSize="16" />

                        <TextBlock x:Name="ChangeStatusText"
                                   FontSize="13"
                                   Foreground="Gray" />

                        <TextBox x:Name="CommitMessageTextBox"
                                 x:Uid="RepoCommitPlaceholder"
                                 MinHeight="32"
                                 AcceptsReturn="False" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="AddAllButton" x:Uid="RepoAddAll"
                                    Click="OnAddAll" MinHeight="32" />
                            <Button x:Name="CommitButton" x:Uid="RepoCommit"
                                    Click="OnCommit" MinHeight="32" />
                            <Button x:Name="RefreshStatusButton" x:Uid="RepoRefreshStatus"
                                    Click="OnRefreshChangeStatus" MinHeight="32" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>