<Page x:Class="FluentGit.Views.RepoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:FluentGit.Views"
      xmlns:l="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">
    <Page.Resources>
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y" From="-80" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y" From="0" To="-80" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="InfoBarContainer" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="20,20,20,0" MinWidth="400" Opacity="0" Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InfoBarTransform" Y="-80" />
            </Border.RenderTransform>
            <InfoBar x:Name="StatusInfoBar" IsOpen="True" IsClosable="False" Severity="Success" Title="" Message="" MaxWidth="500" />
        </Border>

        <Grid Grid.Row="0" Margin="30,24,30,12">
            <TextBlock x:Name="RepoNameDisplay" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,6,30,30" Spacing="24">

                <StackPanel x:Name="GitWarningPanel" Visibility="Collapsed" Spacing="10">
                    <TextBlock l:Uids.Uid="RepoGitNotFound" FontSize="16" Foreground="Red" />
                    <HyperlinkButton l:Uids.Uid="RepoDownloadGit" NavigateUri="https://git-scm.com/install/windows" />
                </StackPanel>

                <StackPanel x:Name="RepoActionsPanel" Visibility="Visible" Spacing="10">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="16">
                            <TextBlock l:Uids.Uid="RepoGettingStarted" FontSize="20" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RepoPathTextBox" Grid.Column="0" l:Uids.Uid="RepoPath" Style="{StaticResource FormTextBoxStyle}" />
                                <Button Grid.Column="1" l:Uids.Uid="RepoBrowse" Click="OnBrowseForInit" Style="{StaticResource FormButtonStyle}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="InitRepoButton" l:Uids.Uid="RepoInit" Click="OnInitRepository" Style="{StaticResource FormButtonStyle}" />
                                <Button x:Name="OpenRepoButton" l:Uids.Uid="RepoOpen" Click="OnOpenRepo" Style="{StaticResource FormButtonStyle}" />
                                <Button x:Name="CloneRepoButton" l:Uids.Uid="RepoClone" Click="OnNavigateToClone" Style="{StaticResource PrimaryFormButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RepoOpsPanel" Visibility="Collapsed" Spacing="10">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="16">
                            <TextBlock l:Uids.Uid="RepoOpsTitle" FontSize="20" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="PullButton" l:Uids.Uid="RepoPull" Click="OnPullRepository" Style="{StaticResource FormButtonStyle}" />
                                <Button x:Name="FetchButton" l:Uids.Uid="RepoFetch" Click="OnFetchRepository" Style="{StaticResource FormButtonStyle}" />
                                <Button x:Name="PushButton" l:Uids.Uid="RepoPush" Click="OnPushRepository" Style="{StaticResource FormButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CommitPanel" Visibility="Collapsed" Spacing="10">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel Spacing="16">
                            <TextBlock l:Uids.Uid="RepoCommitTitle" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChangeStatusText" Style="{StaticResource CaptionTextStyle}" />
                            <TextBox x:Name="CommitMessageTextBox" l:Uids.Uid="RepoCommitPlaceholder" Style="{StaticResource FormTextBoxStyle}" AcceptsReturn="False" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="AddAllButton" l:Uids.Uid="RepoAddAll" Click="OnAddAll" Style="{StaticResource FormButtonStyle}" />
                                <Button x:Name="CommitButton" l:Uids.Uid="RepoCommit" Click="OnCommit" Style="{StaticResource PrimaryFormButtonStyle}" />
                                <Button x:Name="RefreshStatusButton" l:Uids.Uid="RepoRefreshStatus" Click="OnRefreshChangeStatus" Style="{StaticResource FormButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>