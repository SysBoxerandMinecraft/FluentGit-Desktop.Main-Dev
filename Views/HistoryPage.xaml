<Page x:Class="FluentGit.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:services="using:FluentGit.Services"
      mc:Ignorable="d"
      NavigationCacheMode="Required">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,24,30,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Uid="HistoryTitle" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="20" Height="20" Visibility="Collapsed" />
                <Button x:Name="RefreshButton" x:Uid="CommonRefresh" Click="OnRefreshClick" Style="{StaticResource FormButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="30,6,30,30">
            <TextBlock x:Name="NoRepoText" x:Uid="CommonNoRepo" Foreground="Gray" Visibility="Visible" />
            <TextBlock x:Name="EmptyText" x:Uid="HistoryEmpty" Foreground="Gray" Visibility="Collapsed" />
            <ListView x:Name="LogListView" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnCommitItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:GitCommit">
                        <Grid Padding="8,8" ColumnSpacing="12" Background="Transparent" RightTapped="OnItemRightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="OnHashClick" Tag="{x:Bind Hash}" Padding="6,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ShortHash}">
                                <TextBlock Text="{x:Bind ShortHash}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{x:Bind Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Author}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind RelativeTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="80" ToolTipService.ToolTip="{x:Bind DateDisplay}" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="HistoryCopyHash" Click="OnCopyHashClick" Tag="{x:Bind Hash}">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="HistoryCopyShortHash" Click="OnCopyShortHashClick" Tag="{x:Bind ShortHash}">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="HistoryCopyMsg" Click="OnCopyMessageClick" Tag="{x:Bind Message}">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="HistoryViewDetail" Click="OnViewDetailClick">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="View" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>