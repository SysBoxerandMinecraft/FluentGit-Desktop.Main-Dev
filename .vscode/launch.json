            "preLaunchTask": "build-debug",
            "program": "${workspaceFolder}/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64/FluentGit.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            "type": "winapp",
            "request": "launch",
            "name": "WinApp: Launch and Attach"
        }
    ]
}